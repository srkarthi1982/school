DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jai_school

# REQUIRED: must be a random string of at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# The app will refuse to start if this is left as the default value.
SECRET_KEY=REPLACE_ME_WITH_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie settings for the HttpOnly refresh_token cookie.
# Set COOKIE_SECURE=true in production (HTTPS). Leave false for local HTTP dev.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Logging
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARNING
# Rotating file log at backend/logs/app.log (daily, 14 days kept).
# The app writes it itself - never redirect server output to a file.
LOG_TO_FILE=true

# CORS settings
# Set ALLOW_ALL_ORIGINS=true to allow all origins (development only, not for production)
ALLOW_ALL_ORIGINS=true
# List of allowed origins (used when ALLOW_ALL_ORIGINS=false)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Isolated internal 3D aircraft viewer
AIRCRAFT_VIEWER_ENABLED=true

# LDAP Configuration (optional)
LDAP_MOCK=true
LDAP_SERVER=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com
LDAP_SEARCH_FILTER=(uid={username})

# ESNAAD Integration
ESNAAD_BASE_URL=http://jmodl1aitfs01.jac.mil.ae:5008/api
ESNAAD_API_KEY=esnaad-ak-5b4d05d3c85ebb88a171d65419adadb67a0aa4a8
# File Sharing
# Directory where uploaded files are persisted. Can be a local path or a network mount.
FILE_SHARING_UPLOAD_DIR=private_uploads/files
# Maximum individual file size in bytes (default 100 MB)
FILE_SHARING_MAX_FILE_SIZE_BYTES=104857600
# Comma-separated list of allowed MIME types
FILE_SHARING_ALLOWED_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,image/jpeg,image/png,video/mp4,video/webm,video/quicktime,text/plain
# Storage backend adapter: "filesystem" (default). Future: "database", "s3"
FILE_SHARING_STORAGE_BACKEND=filesystem

MATERIAL_UPLOAD_DIR=private_uploads/materials

#LiveKit WebRTC Server
LIVEKIT_URL=wss://jacl1modmcp01.jac.mil.ae:7880
LIVEKIT_API_URL=https://jacl1modmcp01.jac.mil.ae:7880
LIVEKIT_API_KEY=APIhX32zgvngd9i
LIVEKIT_API_SECRET=LvJTn1DjLxHpxGAgOwamNotk2HTOPWjU2j6pgmIMPJL

# Document Summarization Service
DOC_SUMMARY_BASE_URL=http://localhost:8002
DOC_SUMMARY_API_KEY=
DOC_SUMMARY_WEBHOOK_BASE_URL=http://localhost:8000

# AI agent (AskMAI)
# OpenAI-compatible chat-completions endpoint (vLLM, Ollama, etc.).
# The model MUST support native function/tool calling — validate a new
# endpoint with: python -m scripts.validate_llm_tool_calling
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:14b
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
# Skip TLS verification for self-signed internal endpoints
LLM_VERIFY_SSL=false
LLM_TIMEOUT_SECONDS=120

# How many recent chat messages form the agent's conversation memory
AGENT_HISTORY_LIMIT=12
# Max LLM/tool round-trips per user message
AGENT_MAX_ITERATIONS=6
# Max agent runs processed concurrently across all conversations
AGENT_MAX_CONCURRENCY=4
# Hard timeout for one agent run (seconds)
AGENT_RUN_TIMEOUT_SECONDS=180
# Tool results are truncated to this length before entering the prompt
AGENT_TOOL_RESULT_MAX_CHARS=6000

# MCP endpoint (/api/v1/mcp) for external clients — per-user tool-call rate limit
MCP_RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------------
# RAG — semantic search over course materials & library documents
# ---------------------------------------------------------------------------
RAG_ENABLED=true
# Scheduler backfill sweep interval (seconds)
RAG_INGEST_INTERVAL_SECONDS=1800
# Reset rows stuck in status 'indexing' (crash mid-ingest) after N minutes
RAG_STALE_INDEXING_MINUTES=30
RAG_SEARCH_TOP_K=8
RAG_MIN_SCORE=0.0
# Hybrid search: fuse dense (vector) + keyword (Postgres FTS) via Reciprocal Rank Fusion
RAG_HYBRID_ENABLED=true
RAG_RRF_K=60
RAG_HYBRID_CANDIDATES=50
# Per-client rate limit on the RAG search endpoints
RAG_SEARCH_RATE_LIMIT=30/minute
# Normalise Arabic text (strip tashkeel/tatweel, unify alef/ya/ta-marbuta)
# symmetrically before embedding chunks and queries
RAG_ARABIC_NORMALIZE=true
# Comma-separated MIME allow-list for what gets indexed (digital docs only)
RAG_ALLOWED_CONTENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain

# docling-serve — document conversion. Point at your office instance.
# convert_json = request to_formats=json (DoclingDocument, keeps page numbers).
# markdown output is lossy and loses page provenance, so we use json.
DOCLING_BASE_URL=http://155.121.17.79:5001
DOCLING_API_KEY=
DOCLING_TIMEOUT_SECONDS=300
DOCLING_VERIFY_SSL=false
DOCLING_MODE=convert_json
# Submission style: false = sync /v1/convert/file (holds the HTTP connection until
# done); true = docling-serve async task API (submit → poll → result), lighter on
# docling-serve when conversions are slow/queued.
DOCLING_ASYNC=false
DOCLING_POLL_INTERVAL_SECONDS=2.0
# In-process chunker (convert_json only): "hybrid" (token-aware, needs the bge-m3
# tokenizer below) or "hierarchical" (structure-only, NO tokenizer / transformers
# — zero ML deps on this server, but no token-length control).
DOCLING_CHUNKER=hybrid
# Only used by the "hybrid" chunker. Absolute path to a local tokenizer folder
# (see scripts/fetch-bge-m3-tokenizer.py) or a HF repo id with offline cache.
DOCLING_CHUNK_TOKENIZER=BAAI/bge-m3
DOCLING_MAX_TOKENS=512
DOCLING_MERGE_PEERS=true
# Picture description settings for docling-serve (Qwen API).
DOCLING_PICTURE_DESC_URL=http://155.121.25.23:5000/v1/chat/completions
DOCLING_PICTURE_DESC_API_KEY=sk-FCGLgV9vBCvB5NuNEU8q9g
DOCLING_PICTURE_DESC_MODEL=Qwen3.6-35B-A3B

# Embedding sidecar — bge-m3 (1024-dim) via HF text-embeddings-inference / Infinity.
# EMBEDDING_DIM must match the model output AND the pgvector column dimension.
EMBEDDING_BASE_URL=https://litellm.tawasul.mil.ae/
# OpenAI-compatible embeddings route on the sidecar (TEI/Infinity = /v1/embeddings)
EMBEDDING_PATH=/v1/embeddings
EMBEDDING_API_KEY=sk-9IjYf42gR9ewKf3WMtnleA
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_VERIFY_SSL=false
# Embedding backend: "http" (external sidecar, default) or "local" (in-process
# sentence-transformers — no sidecar needed, but pulls torch + loads ~2.3GB per
# process). For local: pip install 'sentence-transformers'
EMBEDDING_BACKEND=http
EMBEDDING_LOCAL_MODEL=BAAI/bge-m3
EMBEDDING_LOCAL_DEVICE=cpu
# Local engine: "sentence-transformers" (dense, lightest) or "flagembedding"
# (official bge-m3, dense now + sparse-ready). pip install for the one you pick:
#   sentence-transformers   OR   FlagEmbedding
EMBEDDING_LOCAL_ENGINE=sentence-transformers
EMBEDDING_BATCH_SIZE=32

DOCLING_CHUNKER=hybrid
DOCLING_CHUNK_TOKENIZER=C:/models/bge-m3-tokenizer
DOCLING_MAX_TOKENS=512
DOCLING_MERGE_PEERS=true
# Picture description settings for docling-serve (Qwen API).
DOCLING_PICTURE_DESC_URL=http://155.121.25.23:5000/v1/chat/completions
DOCLING_PICTURE_DESC_API_KEY=sk-FCGLgV9vBCvB5NuNEU8q9g
DOCLING_PICTURE_DESC_MODEL=Qwen3.6-35B-A3B
# Usage Analytics — feature labels to hide from the "Feature usage" report.
# Comma-separated, matched case-insensitively against the labels in
# app/modules/analytics/feature_map.py. Leave empty to show all features.
# ANALYTICS_EXCLUDED_FEATURES=Notifications,Authentication,Usage Analytics
ANALYTICS_TRACKING_ENABLED=false

# Aircraft Viewer self-extracting package import.
# Example: C:/Program Files/7-Zip/7z.exe
SEVEN_ZIP_PATH=
AIRCRAFT_VIEWER_PACKAGE_MAX_BYTES=524288000
AIRCRAFT_VIEWER_EXTRACTED_MAX_BYTES=2147483648
AIRCRAFT_VIEWER_EXTRACTED_MAX_FILES=20000
AIRCRAFT_VIEWER_EXTRACTION_TIMEOUT_SECONDS=180
AIRCRAFT_VIEWER_TOKEN_EXPIRE_SECONDS=300
