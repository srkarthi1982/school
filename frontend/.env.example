# Backend URL used by:
#   - Vite dev-server proxy (/api/* → backend)
#   - openapi-ts codegen (npm run generate-api)
#   - permissions codegen (npm run generate-permissions)
#
# Runtime requests from the browser use same-origin (Vite proxy in dev,
# FastAPI serving dist/ in prod), so this value is only used during local
# development and code generation.
VITE_BACKEND_URL=http://localhost:8000

# Auto-save interval for Course Information editor (milliseconds).
# After this period, any unsaved (dirty) tab data is automatically persisted as draft.
COURSE_INFO_AUTOSAVE_INTERVAL_MS=15000

# Show the "Personal Access Tokens" section on the Account settings page.
# Hidden by default; set to "true" to enable it (e.g. when MCP access is offered).
VITE_ENABLE_PAT=false